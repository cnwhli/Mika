<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 按住说话时录音，转成文字；用户浏览器里的网页要麦克风时也用它。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 用户浏览器里的网页要摄像头（Nuoyi 自己拍照走系统相机，不用这个权限）；网页请求时先弹框问用户。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 用户浏览器里的网页要定位；网页请求时先弹框问用户。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 用户在关于页下载新版后，交给系统安装器确认覆盖安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 沙箱联网时读当前网络的 DNS 服务器 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 灵动岛胶囊在屏幕顶部画图需要「显示在其他应用上层」;未授权时胶囊不显示,不影响其余功能。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 系统级灵动岛感知通话状态(来电/通话中/挂断),用于胶囊实时显示与通话后整理纪要。 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 批量日程经安卓日历提供方一次写入；用户未授权时退回系统日历的新建页。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- phone_set_alarm / phone_set_timer:经安卓标准接口请时钟 App 设闹钟、计时器(普通权限,安装即有) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 「重启后自动恢复」:开机时重新打开无线调试。这个授权普通安装拿不到,只在用户打开那个开关后
         经已配对的连接授予;不在这里声明的话连授予都做不了 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 对话页附件面板里的「最近的照片」:安卓 13 起读照片,14 起可以只给部分照片,12 及以前读外部存储。
         不给也能用系统照片选择器、文件选择器;拍照走系统相机,不要相机权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 对话页附件可以拍照(走系统相机),声明用到相机、但不是必需:没有相机的设备照常安装。
         有的系统按 APK 特征给应用分类,不声明时 Nuoyi 可能被当成游戏、限制刷新率;这条声明要留着 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 语音输入要麦克风,但不是必需:没有麦克风的设备照常安装,只是用不了语音 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- 网页定位用到位置权限,但不是必需:没有定位硬件的设备照常安装,只是网页拿不到位置 -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- list_apps 列出可启动的 App;解析系统权限框所在的包,用于判断「被切走」 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <!-- 系统动作:先查有没有时钟、日历 App 接,没有就退回去操作界面 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- 语音输入:安卓 11 起不声明这条,查手机自带识别服务永远查不到 -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 引导页先看系统里打不打得开开发者选项页:打不开(有的运行环境不带安卓的系统设置)就一开始说明手机操作用不了 -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <!-- 账号认证器所在的包:没有桌面图标的系统账号登录服务也要看得见,它的登录页冒到主屏上时留给用户处理 -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
    </queries>

    <application
        android:name="com.nuoyi.agent.NuoyiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 界面只有一个:从桌面、通知、别的 App 或命令打开都回到这一个(新的打开交给 onNewIntent),不在上面叠出第二个 -->
        <activity
            android:name="com.nuoyi.agent.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nuoyi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享只进入现有对话页的草稿;文字、链接或一张内容图片都不会自动执行。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 通知里接管按钮的落点:从通知启动 Activity 才会收起通知栏,让用户直接看到挪到主屏的 App -->
        <!-- 语音设置页:系统「默认数字助手」设置项点进来也是这一页,所以对外导出。 -->
        <activity
            android:name="com.nuoyi.agent.voice.VoiceSetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nuoyi" />

        <activity
            android:name="com.nuoyi.agent.takeover.TakeoverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- App 里的文件查看页(网页、Markdown、PDF、图片、文本) -->
        <activity
            android:name="com.nuoyi.agent.ui.viewer.FileViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:theme="@style/Theme.Nuoyi" />

        <!-- 网页接管:把后台的网页标签(同一个 WebView)拿到主屏给用户处理 -->
        <activity
            android:name="com.nuoyi.agent.web.WebTakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- 兼容性自检在 Nuoyi 虚拟屏上操作的测试页。对外开放只为让内置助手(shell)按组件名把它开到 Nuoyi 的屏上:
             调用方必须持有 INTERACT_ACROSS_USERS_FULL,shell 有,普通 App 没有;没有 intent-filter。单独一个任务,不进最近任务 -->
        <activity
            android:name="com.nuoyi.agent.selfcheck.SelfCheckTargetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:windowSoftInputMode="stateHidden" />

        <!--
            公版免手入口:用户在「系统设置 › 应用 › 默认应用 › 数字助手应用」里选中本产品后,
            由系统手势 / 电源键 / 耳机键唤起会话,之后全程不用碰屏幕。
            Android 12 起第三方助手拿不到系统热词(AlwaysOnHotwordDetector 已是 @SystemApi),
            所以公版没有「喊一声就醒」;常驻热词只在 personal 版提供(见该 flavor 的 Manifest)。
            App 不能自己申请默认助手角色,只能引导用户去系统设置里选。
        -->
        <service
            android:name="com.nuoyi.agent.voice.AssistantVoiceInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <!-- 系统每次发起助手会话时绑定它,由它 new 出 AssistantVoiceSession。 -->
        <service
            android:name="com.nuoyi.agent.voice.AssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
            VIA 规范要求同时登记一个 RecognitionService。这里只占位:真正的识别在会话内
            显式挑系统自带的识别服务(AssistantRecognizer),避免绑到自己形成递归。
        -->
        <service
            android:name="com.nuoyi.agent.voice.AssistantRecognitionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <service
            android:name="com.nuoyi.agent.a11y.NuoyiAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name="com.nuoyi.agent.task.TaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-requested phone task on the app's own virtual display and shows its progress; afterwards keeps the one web page the user asked to keep open running, for at most two hours" />
        </service>

        <!-- 灵动岛:把 Nuoyi 自己的通知显示在屏幕顶部居中的胶囊里。需要「显示在其他应用上层」权限,没有时不启动。 -->
        <service
            android:name="com.nuoyi.agent.notify.DynamicIslandService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows Nuoyi's own notifications as a Dynamic-Island-style capsule at the top of the screen" />
        </service>

        <!-- 通话中速记台(从灵动岛胶囊点「记一笔」进入,记录要点 / 下指令)。 -->
        <activity
            android:name="com.nuoyi.agent.ui.CallLiveActivity"
            android:exported="false"
            android:theme="@style/Theme.Nuoyi" />

        <!--
            厂商「通话纪要」是系统 App 里的私有数据:没有对外文件夹、也不给批量导出。
            用户在那个 App 里点「分享 → 诺伊 · 收进纪要库」就把一段文字存进 MinutesInbox,
            攒够之后由诺伊自己全量整理 / 导出。这个 Activity 不显示界面,收完立即退出。
        -->
        <activity
            android:name="com.nuoyi.agent.callnotes.MinutesInboxActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/minutes_inbox_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 常驻「抓取当前屏」通知上的两个动作:不切换前台 Activity 才能读到厂商纪要页面的文字 -->
        <receiver
            android:name="com.nuoyi.agent.callnotes.MinutesCaptureReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nuoyi.agent.action.CAPTURE_MINUTES" />
                <action android:name="com.nuoyi.agent.action.CAPTURE_MINUTES_DONE" />
            </intent-filter>
        </receiver>

        <!-- 开机自启系统级灵动岛(需用户开通过「显示在其他应用上层」)。 -->
        <receiver
            android:name="com.nuoyi.agent.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 用户绑定并打开微信渠道后保持长轮询；没有本地服务器，任务仍交给 TaskService。 -->
        <service
            android:name="com.nuoyi.agent.wechat.WechatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled WeChat bot connection available so private messages can be handed to the app's existing task service" />
        </service>

        <!--
            电脑连接(MCP):用户在设置里打开、或电脑经 USB 调试打开后才运行,让监听端口在后台也开着;关掉就停。
            对外开放只为让 adb shell 能起它(am start-foreground-service):调用方必须持有 INTERACT_ACROSS_USERS_FULL,
            shell 有,普通 App 拿不到,adb 也授不了
        -->
        <service
            android:name="com.nuoyi.agent.mcp.McpService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled computer access available through a private-network or USB endpoint, or an outbound connection to the user's remote gateway, so authorized clients can hand tasks to the app" />
        </service>

        <!-- 用 ChatGPT 登录期间:用户在浏览器里登录时撑住进程,本机回调才有人接;登录一结束就停 -->
        <service
            android:name="com.nuoyi.agent.settings.ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps sign-in alive while the user finishes account login in the external browser, for a loopback callback or device-code polling" />
        </service>

        <!-- 后台准备运行环境(解出随 APK 自带的根文件系统),只在准备期间运行 -->
        <service
            android:name="com.nuoyi.agent.sandbox.SandboxService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 网页上传:把暂存的上传文件以只读 content:// 地址交给内置浏览器的文件选择框,不对外导出。
             FileProvider 要求 grantUriPermissions=true,否则进程启动时就抛异常;
             这里从不把地址授权给别的 App,读取方只有本进程里的 WebView。 -->
        <provider
            android:name="com.nuoyi.agent.web.WebFilesProvider"
            android:authorities="${applicationId}.webfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/web_files" />
        </provider>

        <!-- 对话页附件:相机把照片写进缓存里的 camera/,点开已发附件时复制出的一份在 viewing/;不对外导出,用到时临时授权 -->
        <provider
            android:name="com.nuoyi.agent.chat.AttachFilesProvider"
            android:authorities="${applicationId}.attachfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_files" />
        </provider>

        <!-- 走网络代理时 Nuoyi 自己下的更新安装包:只读交给系统安装器,不对外导出,安装时临时授权 -->
        <provider
            android:name="com.nuoyi.agent.about.UpdateFilesProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_files" />
        </provider>

        <!-- 配对通知输入框填的配对码 -->
        <receiver
            android:name="com.nuoyi.agent.setup.PairingCodeReceiver"
            android:exported="false" />

        <!-- 内置助手(shell 身份)交接 Binder 的入口:shell 有这个权限,普通 App 没有;
             进入后还要核对调用方 uid、一次性口令和 APK,见 HelperHub.offer -->
        <provider
            android:name="com.nuoyi.agent.shell.HelperHandoffProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 开机广播只由系统发出(受保护的广播),按要求导出 -->
        <receiver
            android:name="com.nuoyi.agent.setup.BootRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.nuoyi.agent.task.TriggerAlarmReceiver" android:exported="false" />
        <receiver android:name="com.nuoyi.agent.teach.TeachReceiver" android:exported="false" />
        <!-- 通话纪要里抽出来的提醒:到点在系统闹钟之外弹一条本地通知 -->
        <receiver android:name="com.nuoyi.agent.callnotes.CallNoteReminderReceiver" android:exported="false" />
    </application>

</manifest>
